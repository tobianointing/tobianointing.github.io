         "registrationNumber": "schema:Text",
         "creditUnitsAwarded": "schema:Number",
         "module": {
           "@id": "https://www.tobianointing.com/credentials/terms#module",
           "@context": {
             "@version": 1.1,
             "@protected": true,
             "id": "@id",
             "name": "schema:Text",
             "moduleType": "schema:Text"
           }
         },
         "provider": {
           "@id": "https://www.tobianointing.com/credentials/terms#provider",
           "@context": {
             "@version": 1.1,
             "@protected": true,
             "id": "@id",
             "name": "schema:Text"
           }
         },
         "session": {
