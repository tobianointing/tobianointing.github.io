 {
   "@context": {
     "@version": 1.1,
     "schema": "http://schema.org/",
     "nmcn": "https://nmcn.gov.ng/credentials/terms#",
     "registrationNumber": "nmcn:registrationNumber",
     "creditUnitsAwarded": "nmcn:creditUnitsAwarded",
     "module": {
       "@id": "nmcn:module",
       "@context": {
         "id": "@id",
         "name": "schema:name",
         "type": "nmcn:moduleType"
       }
     },
     "provider": {
       "@id": "nmcn:provider",
       "@context": {
         "id": "@id",
         "name": "schema:name"
       }
     },
     "session": {
       "@id": "nmcn:session",
       "@context": {
         "startDate": "schema:startDate",
         "endDate": "schema:endDate",
         "venue": "nmcn:venue",
         "venueType": "nmcn:venueType"
       }
     }
   }
 }
